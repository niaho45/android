<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        style="@style/FitDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/edit_weight_title"
        android:textSize="18sp" />

    <TextView
        style="@style/FitDialogSubtitle.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/weight_dialog_subtitle" />

    <EditText
        android:id="@+id/etWeightInput"
        style="@style/FitInput"
        android:layout_marginTop="20dp"
        android:hint="@string/hint_weight"
        android:imeOptions="actionDone"
        android:inputType="numberDecimal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDialogCancel"
            style="@style/FitDialogButton.Cancel"
            android:text="@string/action_cancel" />

        <TextView
            android:id="@+id/btnDialogConfirm"
            style="@style/FitDialogButton"
            android:layout_marginLeft="8dp"
            android:text="@string/action_save" />
    </LinearLayout>
</LinearLayout>
