<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        style="@style/FitDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/forgot_answer_title" />

    <TextView
        style="@style/FitDialogSubtitle.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/forgot_answer_subtitle" />

    <TextView
        style="@style/FitFieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_security_question" />

    <TextView
        android:id="@+id/tvSecurityQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_rounded"
        android:gravity="center_vertical"
        android:minHeight="50dp"
        android:paddingLeft="16dp"
        android:paddingTop="14dp"
        android:paddingRight="16dp"
        android:paddingBottom="14dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        style="@style/FitFieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_security_answer" />

    <EditText
        android:id="@+id/etForgotAnswer"
        style="@style/FitInput"
        android:hint="@string/hint_security_answer"
        android:imeOptions="actionDone"
        android:inputType="text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDialogCancel"
            style="@style/FitDialogButton.Cancel"
            android:text="@string/action_cancel" />

        <TextView
            android:id="@+id/btnDialogConfirm"
            style="@style/FitDialogButton"
            android:layout_marginLeft="8dp"
            android:text="@string/action_verify" />
    </LinearLayout>
</LinearLayout>
