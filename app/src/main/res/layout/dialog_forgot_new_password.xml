<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        style="@style/FitDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/forgot_new_title" />

    <TextView
        style="@style/FitDialogSubtitle.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/forgot_new_subtitle" />

    <TextView
        style="@style/FitFieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_new_password" />

    <EditText
        android:id="@+id/etNewPassword"
        style="@style/FitInput"
        android:hint="@string/hint_new_password"
        android:imeOptions="actionNext"
        android:inputType="textPassword" />

    <TextView
        style="@style/FitFieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_confirm_password" />

    <EditText
        android:id="@+id/etConfirmPassword"
        style="@style/FitInput"
        android:hint="@string/hint_new_password"
        android:imeOptions="actionDone"
        android:inputType="textPassword" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDialogCancel"
            style="@style/FitDialogButton.Cancel"
            android:text="@string/action_cancel" />

        <TextView
            android:id="@+id/btnDialogConfirm"
            style="@style/FitDialogButton"
            android:layout_marginLeft="8dp"
            android:text="@string/action_update_password" />
    </LinearLayout>
</LinearLayout>
